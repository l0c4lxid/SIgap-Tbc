{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "*",
        "laravel/framework": "^12.0",
        "laravel/octane": "^2.13",
        "laravel/tinker": "^2.10.1",
        "maatwebsite/excel": "*",
        "maennchen/zipstream-php": "^2.3",
        "smalot/pdfparser": "^2.12",
        "spatie/pdf-to-image": "^1.2",
        "spiral/roadrunner-cli": "*",
        "spiral/roadrunner-http": "*"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.16",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.7",
        "laravel/boost": "^1.8",
        "laravel/breeze": "*",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "*",
        "pestphp/pest-plugin-laravel": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "pnpm install",
            "pnpm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "bash -lc 'PHP_BIN=\"${PHP_BIN:-}\"; if [ -n \"$PHP_BIN\" ] && [ -x \"$PHP_BIN\" ]; then :; elif command -v php >/dev/null 2>&1; then PHP_BIN=\"$(command -v php)\"; elif [ -x /opt/lampp/bin/php ]; then PHP_BIN=\"/opt/lampp/bin/php\"; else echo \"PHP binary tidak ditemukan. Install PHP CLI atau set env PHP_BIN=/path/to/php\" >&2; exit 127; fi; [ -f public/hot ] && rm -f public/hot; echo \"Using PHP binary: ${PHP_BIN}\"; npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"${PHP_BIN} artisan serve --host=127.0.0.1 --port=8000\" \"${PHP_BIN} artisan queue:listen --tries=1 --timeout=0\" \"pnpm run build -- --watch\" --names=server,queue,assets'"
        ],
        "build": [
            "@php -r \"file_exists('public/hot') && unlink('public/hot');\"",
            "pnpm run build"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.2.0",
            "ext-iconv": "8.2.0",
            "ext-sockets": "8.2.0",
            "ext-gd": "8.2.0",
            "ext-zip": "8.2.0",
            "ext-fileinfo": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
